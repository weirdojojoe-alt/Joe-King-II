    line-height: 1.45;
    color: #cbd5e1;
  }
  .meta-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
    margin-top: 8px;
  }
  .meta-cell {
    background: #0f172a;
    border: 1px solid #26354d;
    border-radius: 6px;
    padding: 6px 8px;
    font-size: 0.73rem;
  }
  .meta-cell strong {
    display: block;
    font-size: 0.65rem;
    color: #38bdf8;
    text-transform: uppercase;
    margin-bottom: 2px;
  }

  /* Filter & Node List */
