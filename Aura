    background: transparent;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    color: #f8fafc;
    overflow-x: hidden;
  }

  #app-shell {
    width: 100%;
    height: 700px; /* Hard-locked height so Google Sites never clips or loses the bottom */
    max-height: 700px;
    background: #070b14;
    border: 2px solid #38bdf8;
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0,0,0,0.65);
