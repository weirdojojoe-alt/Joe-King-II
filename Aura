  /* =========================================================================
     2. BUILT-IN ZERO-DEPENDENCY 3D ENGINE (HTML5 CANVAS)
     ========================================================================= */
  const canvas = document.getElementById("stage3d");
  const ctx = canvas.getContext("2d");

  let rotY = 0.25, rotX = 0.08, zoom = 1.0, autoSpin = false;
  let isDragging = false, lastX = 0, lastY = 0;
  let selectedId = "GV20";
  let highlightedIds = new Set();
  let projectedHitBoxes = [];

  // Layer states
  const layers = {
    body: true, meridians: true, points: true,
    chakras: true, aura: true, reiki: false, shield: false
  };

  // Pre-build 3D Human Silhouette Rings (Head, Neck, Torso, Pelvis, Arms, Legs)
  const bodyRings = [];
  function generateBodyMesh() {
    // Head
    for (let i = 0; i <= 6; i++) {
      const t = i / 6;
      const y = 0.65 + t * 0.20;
      const r = Math.sin(t * Math.PI) * 0.095 + 0.02;
      bodyRings.push({ cx: 0, y, rx: r * 0.9, rz: r, segs: 12 });
    }
    // Neck
    bodyRings.push({ cx: 0, y: 0.58, rx: 0.048, rz: 0.048, segs: 10 });
    // Torso & Pelvis
    const torsoProfile = [
      { y: 0.50, rx: 0.17, rz: 0.10 },
      { y: 0.36, rx: 0.16, rz: 0.12 },
      { y: 0.20, rx: 0.13, rz: 0.11 },
      { y: 0.05, rx: 0.14, rz: 0.11 },
      { y: -0.10, rx: 0.15, rz: 0.11 }
    ];
    torsoProfile.forEach(p => bodyRings.push({ cx: 0, y: p.y, rx: p.rx, rz: p.rz, segs: 16 }));

    // Left & Right Legs
    [-1, 1].forEach(s => {
      [-0.22, -0.36, -0.50, -0.66, -0.82].forEach((y, idx) => {
        const r = 0.068 - idx * 0.007;
        bodyRings.push({ cx: s * 0.11, y, rx: r, rz: r, segs: 10 });
      });
    });
  }
  generateBodyMesh();

  function resizeCanvas() {
    const rect = canvas.parentElement.getBoundingClientRect();
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    canvas.width = Math.max(300, rect.width) * dpr;
    canvas.height = Math.max(300, rect.height) * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }

  function project3D(x, y, z, w, h) {
    // Rotate around Y
    const cosY = Math.cos(rotY), sinY = Math.sin(rotY);
    const x1 = x * cosY - z * sinY;
    const z1 = x * sinY + z * cosY;
    // Rotate around X
    const cosX = Math.cos(rotX), sinX = Math.sin(rotX);
    const y2 = y * cosX - z1 * sinX;
    const z2 = y * sinX + z1 * cosX;

    const fov = 2.6;
    const scale = (Math.min(w, h) * 0.46 * zoom) * (fov / (fov + z2 + 1.2));
    return {
      sx: w * 0.5 + x1 * scale,
      sy: h * 0.49 - y2 * scale,
      z: z2,
      scale
    };
  }

  function draw3DScene(time) {
    const w = canvas.clientWidth || 420;
    const h = canvas.clientHeight || 500;
    ctx.clearRect(0, 0, w, h);
    const t = time * 0.002;

    if (autoSpin && !isDragging) rotY += 0.008;

    // 1. Draw Floor Perspective Grid
    ctx.strokeStyle = "rgba(56, 189, 248, 0.16)";
    ctx.lineWidth = 1;
    for (let g = -0.5; g <= 0.5; g += 0.25) {
      const p1 = project3D(g, -0.90, -0.5, w, h);
      const p2 = project3D(g, -0.90, 0.5, w, h);
      ctx.beginPath(); ctx.moveTo(p1.sx, p1.sy); ctx.lineTo(p2.sx, p2.sy); ctx.stroke();
      const p3 = project3D(-0.5, -0.90, g, w, h);
      const p4 = project3D(0.5, -0.90, g, w, h);
      ctx.beginPath(); ctx.moveTo(p3.sx, p3.sy); ctx.lineTo(p4.sx, p4.sy); ctx.stroke();
    }

    // 2. Draw 3-Tier Aura Biofield Envelopes
    if (layers.aura) {
      const auraTiers = [
        { rx: 0.36, ry: 0.96, col: "rgba(56, 189, 248, 0.20)" },
        { rx: 0.46, ry: 1.04, col: "rgba(192, 132, 252, 0.16)" },
        { rx: 0.56, ry: 1.12, col: "rgba(250, 204, 21, 0.12)" }
      ];
      auraTiers.forEach((a, idx) => {
        ctx.strokeStyle = a.col;
        ctx.lineWidth = 1.2;
        ctx.beginPath();
        for (let i = 0; i <= 36; i++) {
          const ang = (i / 36) * Math.PI * 2;
          const px = Math.cos(ang) * a.rx * (1 + Math.sin(t + idx) * 0.03);
          const py = Math.sin(ang) * a.ry;
          const pr = project3D(px, py, 0, w, h);
          if (i === 0) ctx.moveTo(pr.sx, pr.sy); else ctx.lineTo(pr.sx, pr.sy);
        }
        ctx.stroke();
      });
    }

    // 3. Draw 3D Anatomical Wireframe Rings + Limb Bones + Central Spine
    if (layers.body) {
      ctx.strokeStyle = "rgba(56, 189, 248, 0.28)";
      ctx.lineWidth = 1;
      bodyRings.forEach(r => {
        ctx.beginPath();
        for (let i = 0; i <= r.segs; i++) {
          const a = (i / r.segs) * Math.PI * 2;
          const px = r.cx + Math.cos(a) * r.rx;
          const pz = Math.sin(a) * r.rz;
          const pr = project3D(px, r.y, pz, w, h);
          if (i === 0) ctx.moveTo(pr.sx, pr.sy); else ctx.lineTo(pr.sx, pr.sy);
        }
        ctx.stroke();
      });

      // Arms & Central Spinal Sushumna Conduit
      [-1, 1].forEach(s => {
        const armPts = [
          [s * 0.17, 0.48, 0], [s * 0.29, 0.24, 0.02],
          [s * 0.38, 0.04, 0.05], [s * 0.44, -0.06, 0.08]
        ];
        ctx.strokeStyle = "rgba(56, 189, 248, 0.42)";
        ctx.lineWidth = 3;
        ctx.beginPath();
        armPts.forEach((pt, i) => {
          const pr = project3D(pt[0], pt[1], pt[2], w, h);
          if (i === 0) ctx.moveTo(pr.sx, pr.sy); else ctx.lineTo(pr.sx, pr.sy);
        });
        ctx.stroke();
      });

      // Glowing Central Spinal Cord / Sushumna
      const spTop = project3D(0, 0.84, 0, w, h);
      const spBot = project3D(0, -0.14, 0, w, h);
      ctx.strokeStyle = "rgba(232, 121, 249, 0.55)";
      ctx.lineWidth = 2.5;
      ctx.beginPath(); ctx.moveTo(spTop.sx, spTop.sy); ctx.lineTo(spBot.sx, spBot.sy); ctx.stroke();
    }

    // 4. Draw 12 Meridian & CV/GV Pathways
    if (layers.meridians) {
      const channels = [
        // Conception Vessel (Anterior Midline)
        { col: "rgba(245, 158, 11, 0.65)", pts: [[0,0.50,0.12],[0,0.34,0.15],[0,0.16,0.15],[0,-0.02,0.14],[0,-0.14,0]] },
        // Governing Vessel (Posterior Midline)
        { col: "rgba(56, 189, 248, 0.65)", pts: [[0,0.84,0],[0,0.67,-0.10],[0,0.35,-0.13],[0,0.08,-0.12],[0,-0.14,-0.08]] },
        // Stomach / Spleen / Liver Leg trajectories (mirrored)
        { col: "rgba(52, 211, 153, 0.55)", mirror:true, pts: [[0.14,0.10,0.11],[0.14,-0.20,0.10],[0.14,-0.48,0.09],[0.13,-0.82,0.11]] },
        // Bladder Dorsal Line (mirrored)
        { col: "rgba(96, 165, 250, 0.55)", mirror:true, pts: [[0.08,0.67,-0.10],[0.09,0.38,-0.13],[0.09,0.08,-0.12],[0.13,-0.42,-0.09],[0.13,-0.84,-0.04]] }
      ];
      channels.forEach(ch => {
        const sides = ch.mirror ? [-1, 1] : [1];
        sides.forEach(s => {
          ctx.strokeStyle = ch.col;
          ctx.lineWidth = 1.6;
          ctx.beginPath();
          ch.pts.forEach((pt, idx) => {
            const pr = project3D(pt[0] * s, pt[1], pt[2], w, h);
            if (idx === 0) ctx.moveTo(pr.sx, pr.sy); else ctx.lineTo(pr.sx, pr.sy);
          });
          ctx.stroke();
        });
      });
    }

    // 5. Draw 7 Pulsing Chakra Rings
    if (layers.chakras) {
      const chakras = [
        { y: -0.14, col: "#ef4444" },
        { y: -0.02, col: "#f97316" },
        { y: 0.16,  col: "#eab308" },
        { y: 0.34,  col: "#22c55e" },
        { y: 0.50,  col: "#38bdf8" },
        { y: 0.75,  col: "#818cf8" },
        { y: 0.84,  col: "#e879f9" }
      ];
      chakras.forEach((c, idx) => {
        const pulse = 0.055 + Math.sin(t * 2 + idx) * 0.008;
        ctx.strokeStyle = c.col;
        ctx.lineWidth = 2;
        ctx.beginPath();
        for (let i = 0; i <= 20; i++) {
          const a = (i / 20) * Math.PI * 2;
          const pr = project3D(Math.cos(a) * pulse, c.y, Math.sin(a) * pulse, w, h);
          if (i === 0) ctx.moveTo(pr.sx, pr.sy); else ctx.lineTo(pr.sx, pr.sy);
        }
        ctx.stroke();
      });
    }

    // 6. Draw Reiki Byosen Scanning Rings
    if (layers.reiki) {
      for (let r = 0; r < 2; r++) {
        const scanY = Math.sin(t * 1.2 + r * 2) * 0.75;
        ctx.strokeStyle = "rgba(52, 211, 153, 0.75)";
        ctx.lineWidth = 2.2;
        ctx.beginPath();
        for (let i = 0; i <= 28; i++) {
          const a = (i / 28) * Math.PI * 2;
          const pr = project3D(Math.cos(a) * 0.28, scanY, Math.sin(a) * 0.22, w, h);
          if (i === 0) ctx.moveTo(pr.sx, pr.sy); else ctx.lineTo(pr.sx, pr.sy);
        }
        ctx.stroke();
      }
    }

    // 7. Draw Toroidal Warding Shield
    if (layers.shield) {
      ctx.strokeStyle = "rgba(244, 63, 94, 0.45)";
      ctx.lineWidth = 1.4;
      for (let m = 0; m < 6; m++) {
        const meridAng = (m / 6) * Math.PI + t * 0.4;
        ctx.beginPath();
        for (let i = 0; i <= 28; i++) {
          const a = (i / 28) * Math.PI * 2;
          const rad = Math.sin(a) * 0.52;
          const px = Math.cos(meridAng) * rad;
          const pz = Math.sin(meridAng) * rad;
          const py = Math.cos(a) * 1.02;
          const pr = project3D(px, py, pz, w, h);
          if (i === 0) ctx.moveTo(pr.sx, pr.sy); else ctx.lineTo(pr.sx, pr.sy);
        }
        ctx.stroke();
      }
    }

    // 8. Draw Clickable 3D Acupoints, Chakras & Auricular Nodes
    projectedHitBoxes = [];
    NODES.forEach(n => {
      if (n.cat === "chakra" && !layers.chakras) return;
      if (n.cat !== "chakra" && !layers.points) return;

      const coords = [n.pos];
      if (n.mirror) coords.push([-n.pos[0], n.pos[1], n.pos[2]]);

      coords.forEach((pt, sideIdx) => {
        const pr = project3D(pt[0], pt[1], pt[2], w, h);
        const isSel = n.id === selectedId;
        const isDiag = highlightedIds.has(n.id);

        let fill = n.cat === "chakra" ? "#c084fc" : (n.cat === "aur" ? "#34d399" : "#f59e0b");
        let radius = isSel ? 7.5 : (isDiag ? 7.0 : 4.8);
        if (isSel) fill = "#38bdf8";
        else if (isDiag) fill = "#10b981";

        // Outer glow
        if (isSel || isDiag) {
          ctx.fillStyle = isSel ? "rgba(56, 189, 248, 0.32)" : "rgba(16, 185, 129, 0.32)";
          ctx.beginPath();
          ctx.arc(pr.sx, pr.sy, radius + 5, 0, Math.PI * 2);
          ctx.fill();
        }

        ctx.fillStyle = fill;
        ctx.strokeStyle = "#020617";
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        ctx.arc(pr.sx, pr.sy, radius, 0, Math.PI * 2);
        ctx.fill();
        ctx.stroke();

        // Callout label on primary side
        if ((isSel || isDiag) && sideIdx === 0) {
          ctx.fillStyle = "#f8fafc";
          ctx.font = "bold 11px sans-serif";
          ctx.fillText(n.code.split(" ")[0], pr.sx + 9, pr.sy + 4);
        }

        projectedHitBoxes.push({ id: n.id, x: pr.sx, y: pr.sy, r: 13 });
      });
    });

    requestAnimationFrame(draw3DScene);
  }

  /* =========================================================================
     3. POINTER & UI EVENT LISTENERS (NO INLINE ONCLICK DEPENDENCIES)
     ========================================================================= */
  canvas.addEventListener("pointerdown", e => {
    const rect = canvas.getBoundingClientRect();
    const mx = e.clientX - rect.left;
    const my = e.clientY - rect.top;

    // Check if user tapped a 3D node
    for (let i = projectedHitBoxes.length - 1; i >= 0; i--) {
      const b = projectedHitBoxes[i];
      const dist = Math.hypot(mx - b.x, my - b.y);
      if (dist <= b.r) {
        selectNode(b.id);
        return;
      }
    }

    isDragging = true;
    lastX = e.clientX;
    lastY = e.clientY;
    canvas.setPointerCapture(e.pointerId);
  });

  canvas.addEventListener("pointermove", e => {
    if (!isDragging) return;
    const dx = e.clientX - lastX;
    const dy = e.clientY - lastY;
    rotY += dx * 0.01;
    rotX = Math.max(-0.8, Math.min(0.8, rotX + dy * 0.008));
    lastX = e.clientX;
    lastY = e.clientY;
  });

  canvas.addEventListener("pointerup", () => { isDragging = false; });

  // Camera Presets & Zoom
  document.querySelectorAll("[data-cam]").forEach(btn => {
    btn.addEventListener("click", () => {
      const mode = btn.getAttribute("data-cam");
      if (mode === "front") { rotY = 0; rotX = 0.05; zoom = 1.0; }
      else if (mode === "back") { rotY = Math.PI; rotX = 0.05; zoom = 1.0; }
      else if (mode === "side") { rotY = Math.PI * 0.5; rotX = 0.05; zoom = 1.0; }
      else if (mode === "head") { rotY = 0.2; rotX = -0.15; zoom = 1.65; }
      else if (mode === "spin") {
        autoSpin = !autoSpin;
        btn.textContent = "Auto-Spin: " + (autoSpin ? "ON" : "OFF");
      }
    });
  });

  document.getElementById("btn-zoom-in").addEventListener("click", () => { zoom = Math.min(2.2, zoom + 0.2); });
  document.getElementById("btn-zoom-out").addEventListener("click", () => { zoom = Math.max(0.65, zoom - 0.2); });

  // Layer Checkboxes
  const layerMap = {
    "chk-body": "body", "chk-meridians": "meridians", "chk-points": "points",
    "chk-chakras": "chakras", "chk-aura": "aura", "chk-reiki": "reiki", "chk-shield": "shield"
  };
  Object.keys(layerMap).forEach(id => {
    document.getElementById(id).addEventListener("change", e => {
      layers[layerMap[id]] = e.target.checked;
    });
  });

  // Main Navigation Tabs
  document.querySelectorAll("#main-tabs .tab-btn").forEach(btn => {
    btn.addEventListener("click", () => {
      const target = btn.getAttribute("data-tab");
      document.querySelectorAll("#main-tabs .tab-btn").forEach(b => b.classList.remove("active"));
      btn.classList.add("active");
      document.querySelectorAll(".tab-pane").forEach(p => p.classList.remove("active"));
      document.getElementById("pane-" + target).classList.add("active");
    });
  });

  // Select Node & Render List
  function selectNode(id) {
    selectedId = id;
    const n = NODES.find(x => x.id === id);
    if (!n) return;

    document.getElementById("hud-cat").textContent = n.mer;
    document.getElementById("hud-code").textContent = n.code;
    document.getElementById("hud-title").textContent = n.name;

    document.getElementById("info-title").textContent = n.code + " — " + n.name;
    document.getElementById("info-badge").textContent = n.mer;
    document.getElementById("info-neuro").textContent = n.neuro;
    document.getElementById("info-tcm").textContent = n.tcm;
    document.getElementById("info-aura").textContent = n.aura;
    document.getElementById("info-reiki").textContent = n.reiki;

    // Rotate 3D model toward Posterior if a back point is selected
    if (n.pos[2] < -0.05) rotY = Math.PI * 0.85;
    else if (Math.abs(rotY) > Math.PI * 0.6) rotY = 0.25;

    renderNodeList();
  }

  function renderNodeList() {
    const q = document.getElementById("search-nodes").value.toLowerCase();
    const f = document.getElementById("filter-meridian").value;
    const box = document.getElementById("node-list-container");
    box.innerHTML = "";

    NODES.filter(n => {
      const matchCat = f === "ALL" || n.cat === f;
      const matchTxt = (n.code + n.name + n.mer + n.neuro + n.tcm + n.aura).toLowerCase().includes(q);
      return matchCat && matchTxt;
    }).forEach(n => {
      const row = document.createElement("div");
      row.className = "node-row" + (n.id === selectedId ? " active" : "");
      const pillClass = n.cat === "chakra" ? "p-chk" : (n.cat === "aur" ? "p-aur" : "p-acu");
      row.innerHTML = `
        <div>
          <div style="font-weight:700; font-size:0.78rem; color:#fff;">${n.code} — ${n.name}</div>
          <div style="font-size:0.7rem; color:#94a3b8;">${n.mer} | ${n.neuro.slice(0, 48)}...</div>
        </div>
        <span class="pill ${pillClass}">${n.cat.toUpperCase()}</span>
      `;
      row.addEventListener("click", () => selectNode(n.id));
      box.appendChild(row);
    });
  }

  document.getElementById("search-nodes").addEventListener("input", renderNodeList);
  document.getElementById("filter-meridian").addEventListener("change", renderNodeList);

  // Diagnostics Triage
  const activeTags = new Set();
  document.querySelectorAll("#diag-chips .chip").forEach(chip => {
    chip.addEventListener("click", () => {
      const tag = chip.getAttribute("data-tag");
      chip.classList.toggle("active");
      if (activeTags.has(tag)) activeTags.delete(tag); else activeTags.add(tag);
    });
  });

  document.getElementById("btn-run-diag").addEventListener("click", () => {
    const matched = NODES.filter(n => n.tags.some(t => activeTags.has(t)));
    const titleEl = document.getElementById("diag-result-title");
    const listEl = document.getElementById("diag-result-list");
    listEl.innerHTML = "";
    highlightedIds.clear();

    if (matched.length === 0) {
      titleEl.textContent = "Tap at least one physical or biofield finding above first.";
      return;
    }

    matched.forEach(m => highlightedIds.add(m.id));
    layers.reiki = true;
    document.getElementById("chk-reiki").checked = true;

    titleEl.innerHTML = `<strong style="color:#34d399;">${matched.length} Target Nodes Illuminated in Green on 3D Model:</strong>`;
    matched.forEach(m => {
      const li = document.createElement("li");
      li.style.marginBottom = "6px";
      li.innerHTML = `<strong>${m.code} (${m.name}):</strong> ${m.tcm} <em>[Reiki/Subtle: ${m.reiki}]</em>`;
      listEl.appendChild(li);
    });
  });

  // Warding & Session Notes
  document.querySelectorAll(".ward-chk").forEach(chk => {
    chk.addEventListener("change", () => {
      const all = document.querySelectorAll(".ward-chk");
      let count = 0;
      all.forEach(c => { if (c.checked) count++; });
      const pct = Math.round((count / all.length) * 100);
      layers.shield = count > 0;
      document.getElementById("chk-shield").checked = count > 0;
      document.getElementById("ward-readout").textContent =
        count > 0 ? `3D Toroidal Ward: ACTIVE (${pct}% Containment Integrity)` : "3D Toroidal Ward: INACTIVE";
    });
  });

  document.getElementById("btn-build-note").addEventListener("click", () => {
    const client = document.getElementById("note-client").value || "Self / General Practice";
    const mod = document.getElementById("note-modality").value;
    const curNode = NODES.find(x => x.id === selectedId);
    const diagList = Array.from(highlightedIds).map(id => NODES.find(x => x.id === id)?.code).filter(Boolean);

    const text = [
      `=== SOMASPIRIT CLINICAL & ENERGETIC SESSION NOTE ===`,
      `Client / Focus: ${client} | Modality: ${mod}`,
      `Primary Inspected Node: ${curNode.code} (${curNode.name}) — ${curNode.neuro}`,
      `Active Triage Protocol Nodes: ${diagList.length ? diagList.join(", ") : curNode.code}`,
      `Subtle & Reiki Integration: ${curNode.aura} | ${curNode.reiki}`,
      `Practitioner Warding Status: ${document.getElementById("ward-readout").textContent}`,
      `Gokai Affirmation: "Just for today, do not anger, do not worry, be grateful, work diligently, be kind."`
    ].join("\n");
    document.getElementById("note-output").value = text;
  });

  document.getElementById("btn-copy-note").addEventListener("click", () => {
    const out = document.getElementById("note-output");
    out.select();
    document.execCommand("copy");
    document.getElementById("btn-copy-note").textContent = "Copied to Clipboard!";
    setTimeout(() => { document.getElementById("btn-copy-note").textContent = "Copy Session Note to Clipboard"; }, 2000);
  });

  // Synthesized 5-Book Codex
  let curAlpha = "ALL", curChap = "ALL";
  const alphaContainer = document.getElementById("codex-alpha");
  ["ALL", "A", "B", "C", "F", "G", "H", "S", "W"].forEach(l => {
    const b = document.createElement("button");
    b.type = "button";
    b.className = "mini-btn" + (l === "ALL" ? " active" : "");
    b.textContent = l;
    b.addEventListener("click", () => {
      curAlpha = l;
      alphaContainer.querySelectorAll(".mini-btn").forEach(x => x.classList.remove("active"));
      b.classList.add("active");
      renderCodex();
    });
    alphaContainer.appendChild(b);
  });

  const chapContainer = document.getElementById("codex-chaps");
  ["ALL", "I. Medical Acupuncture", "II. Biofield & Auras", "III. Reiki Pathwork", "IV. Spiritual Protection", "V. Integrative Hypnotherapy"].forEach(c => {
    const b = document.createElement("button");
    b.type = "button";
    b.className = "mini-btn" + (c === "ALL" ? " active" : "");
    b.textContent = c;
    b.addEventListener("click", () => {
      curChap = c;
      chapContainer.querySelectorAll(".mini-btn").forEach(x => x.classList.remove("active"));
      b.classList.add("active");
      renderCodex();
    });
    chapContainer.appendChild(b);
  });

  function renderCodex() {
    const q = document.getElementById("codex-query").value.toLowerCase();
    const list = document.getElementById("codex-list");
    list.innerHTML = "";

    CODEX.filter(e => {
      const mA = curAlpha === "ALL" || e.let === curAlpha;
      const mC = curChap === "ALL" || e.chap === curChap;
      const mQ = (e.title + e.body + e.src + e.chap).toLowerCase().includes(q);
      return mA && mC && mQ;
    }).forEach(e => {
      const d = document.createElement("div");
      d.className = "card";
      d.innerHTML = `
        <div style="font-size:0.66rem; color:#34d399; font-weight:800; text-transform:uppercase;">${e.chap} — Index [${e.let}]</div>
        <h3 style="margin-top:2px;">${e.title}</h3>
        <p>${e.body}</p>
        <div style="margin-top:5px; font-size:0.68rem; color:#38bdf8;">Source: ${e.src}</div>
      `;
      list.appendChild(d);
    });
  }

  document.getElementById("codex-query").addEventListener("input", renderCodex);

  // Boot Everything Immediately
  window.addEventListener("resize", resizeCanvas);
  resizeCanvas();
  renderNodeList();
  renderCodex();
  requestAnimationFrame(draw3DScene);
})();
</script>
</body>
</html>
