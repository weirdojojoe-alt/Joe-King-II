    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    flex-shrink: 0;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 800;
    font-size: 0.92rem;
    color: #f8fafc;
  }
  .badge-3d {
    background: linear-gradient(135deg, #38bdf8, #c084fc);
    color: #020617;
    font-size: 0.7rem;
    padding: 2px 7px;
    border-radius: 4px;
    font-weight: 900;
  }
  .tab-bar {
    display: flex;
    gap: 5px;
    flex-wrap: wrap;
  }
  .tab-btn {
    background: #1e293b;
    color: #cbd5e1;
    border: 1px solid #475569;
    padding: 6px 10px;
    border-radius: 6px;
    font-size: 0.76rem;
    font-weight: 700;
    cursor: pointer;
    transition: 0.15s;
  }
  .tab-btn:hover { border-color: #38bdf8; color: #fff; }
  .tab-btn.active {
    background: #0284c7;
    color: #fff;
    border-color: #38bdf8;
    box-shadow: 0 0 10px rgba(56,189,248,0.4);
  }

  /* MAIN SPLIT WORKSPACE */
  .main-area {
    flex: 1;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    min-height: 0; /* Critical for internal scrolling */
    overflow: hidden;
  }
  @media (max-width: 780px) {
    #app-shell { height: 860px; max-height: 860px; }
    .main-area {
      grid-template-columns: 1fr;
      grid-template-rows: 360px 1fr;
    }
