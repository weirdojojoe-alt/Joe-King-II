  .stage-wrap {
    position: relative;
    background: radial-gradient(circle at 50% 42%, #111c35 0%, #050811 100%);
    border-right: 1px solid #334155;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    min-height: 0;
  }
  #stage3d {
    width: 100%;
    height: 100%;
    display: block;
    cursor: grab;
    touch-action: none;
  }
  #stage3d:active { cursor: grabbing; }

  /* Floating Overlay Controls inside 3D Viewport */
  .layer-box {
    position: absolute;
    top: 8px;
    left: 8px;
    background: rgba(15, 23, 42, 0.88);
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 8px 10px;
    font-size: 0.72rem;
    display: flex;
    flex-direction: column;
    gap: 4px;
    z-index: 5;
  }
  .layer-box label {
    display: flex;
    align-items: center;
    gap: 6px;
    cursor: pointer;
    color: #e2e8f0;
  }
  .hud-pill {
    position: absolute;
    top: 8px;
    right: 8px;
    background: rgba(15, 23, 42, 0.92);
    border: 1px solid #38bdf8;
    border-radius: 8px;
    padding: 7px 10px;
    max-width: 195px;
    font-size: 0.73rem;
    z-index: 5;
  }
  .stage-toolbar {
    position: absolute;
    bottom: 8px;
    left: 8px;
    right: 8px;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 4px;
    z-index: 5;
