  .cam-btn {
    background: rgba(15, 23, 42, 0.92);
    color: #e2e8f0;
    border: 1px solid #475569;
    padding: 4px 8px;
    border-radius: 5px;
    font-size: 0.71rem;
    font-weight: 600;
    cursor: pointer;
